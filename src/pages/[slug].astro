---
import Layout from "../layouts/Layout.astro";
import ListContainer from "../components/ListContainer";
import ShareButton from "../components/ShareButton";
import DeleteListButton from "../components/DeleteListButton";
import { client } from "../utils/db";
import type { List, Link } from "../types/link";

const { slug } = Astro.params;

// Fetch list data
const listResult = await client.query("SELECT * FROM lists WHERE slug = $1", [slug]);

if (listResult.rows.length === 0) {
  return Astro.redirect("/404");
}

const list: List = listResult.rows[0];

// Fetch links for this list
const linksResult = await client.query(
  "SELECT * FROM links WHERE list_id = $1 ORDER BY position ASC, created_at ASC",
  [list.id]
);
const links: Link[] = linksResult.rows;

const pageUrl = Astro.url.href;
---

<Layout title={`${list.title} - The Urlist`}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-4xl mx-auto px-4 py-6">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-[#15BFAE]"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="text-2xl font-bold text-gray-900">The Urlist</span>
          </a>
          <a
            href="/create"
            class="px-4 py-2 bg-[#15BFAE] text-white font-medium rounded-lg hover:bg-[#13a89a] transition-colors"
          >
            Create New List
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-8">
      <!-- List Header -->
      <div class="mb-8">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">{list.title}</h1>
            {list.description && (
              <p class="text-gray-600">{list.description}</p>
            )}
          </div>
          <div class="flex items-center gap-2">
            <ShareButton client:load url={pageUrl} />
            <DeleteListButton client:load listId={list.id} />
          </div>
        </div>
      </div>

      <!-- Links Container -->
      <ListContainer client:load listId={list.id} initialLinks={links} />
    </main>
  </div>
</Layout>
