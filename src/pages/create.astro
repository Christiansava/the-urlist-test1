---
import Layout from "../layouts/Layout.astro";
import CreateList from "../components/CreateList";
import UserNav from "../components/UserNav";
---

<Layout title="Create New List - The Urlist">
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white border-b border-gray-200">
      <div class="max-w-4xl mx-auto px-4 py-6">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-8 w-8 text-[#15BFAE]"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M12.586 4.586a2 2 0 112.828 2.828l-3 3a2 2 0 01-2.828 0 1 1 0 00-1.414 1.414 4 4 0 005.656 0l3-3a4 4 0 00-5.656-5.656l-1.5 1.5a1 1 0 101.414 1.414l1.5-1.5zm-5 5a2 2 0 012.828 0 1 1 0 101.414-1.414 4 4 0 00-5.656 0l-3 3a4 4 0 105.656 5.656l1.5-1.5a1 1 0 10-1.414-1.414l-1.5 1.5a2 2 0 11-2.828-2.828l3-3z"
                clip-rule="evenodd"
              />
            </svg>
            <span class="text-2xl font-bold text-gray-900">The Urlist</span>
          </a>
          <UserNav client:load />
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-12">
      <div class="max-w-md mx-auto">
        <h1 class="text-3xl font-bold text-gray-900 mb-2 text-center">
          Create a New List
        </h1>
        <p class="text-gray-600 text-center mb-8">
          Start collecting and sharing your favorite links.
        </p>

        <CreateList client:load />

        <p class="text-center text-sm text-gray-500 mt-6">
          <a href="/" class="text-[#15BFAE] hover:underline">
            ← Back to all lists
          </a>
        </p>
      </div>
    </main>
  </div>
</Layout>
