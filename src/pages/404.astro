---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found - The Urlist">
  <div class="min-h-screen bg-gray-50 flex items-center justify-center">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-gray-300 mb-4">404</h1>
      <h2 class="text-2xl font-semibold text-gray-700 mb-2">List Not Found</h2>
      <p class="text-gray-500 mb-6">
        The list you're looking for doesn't exist or has been deleted.
      </p>
      <a
        href="/"
        class="inline-block px-6 py-3 bg-[#15BFAE] text-white font-medium rounded-xl hover:bg-[#13a89a] transition-colors"
      >
        Go to Homepage
      </a>
    </div>
  </div>
</Layout>
